# Local data directory. All pipeline output (lake, warehouse, logs, caches) lives here.
# Create this directory or any parent directories before running; the pipeline will create subdirs.
MLB_DATA_DIR=./data

# Lookback window in days. On catch-up, re-pull this many days before the last successful load
# to capture any revisions made by the data source. Keep this small; default is reasonable.
LOOKBACK_DAYS=4

# Maximum gap in days before catch-up refuses to run and asks for an explicit backfill command.
# Prevents silently skipping large date ranges if the pipeline hasn't run in a while.
MAX_CATCHUP_DAYS=30

# Automatic backfill (--chunk-days, Phase 2 P2M4): where history starts, and how many days
# each --chunk-days firing (with no explicit N) loads before stopping. Tracked separately
# from the catch-up watermark in backfilled_through, so .github/workflows/backfill.yml can
# run alongside scheduled-ingest.yml without either resetting the other's progress.
BACKFILL_START=2015-04-01
BACKFILL_CHUNK_DAYS=30

# Giants team_id for reference (not yet used in filtering, but available for future features).
GIANTS_TEAM_ID=137

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# dbt schema naming mode. In dev mode, schemas are prefixed with dbt_<username>_
# to isolate each developer's work. In production, schemas use clean names.
# Leave as 'dev' for local development; set to 'production' for CI/prod.
DBT_OUTPUT_MODE=dev

# ============================================================================
# Lake destination (Phase 2), in the order Cloudflare shows them. Leave these
# empty / false for the local lake under MLB_DATA_DIR, which is what
# development and CI use.
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: the S3 credentials of an R2 API
#   token. Secrets: set them only in your own .env (gitignored) or as GitHub
#   Actions Secrets, never in this file.
# S3_BUCKET_URL: where dlt writes the raw Parquet lake.
#   empty (default) -> <MLB_DATA_DIR>/lake
#   https://<account id>.r2.cloudflarestorage.com/<bucket>[/<folder>]
#                   -> Cloudflare R2. Paste the bucket's "S3 API" URL
#                      (R2 -> your bucket -> Settings), optionally with a
#                      folder, e.g. .../mlb-lake/prod. It must end in the
#                      bucket name, not stop at the account endpoint (.com/).
# IS_PROD: must be true to write to R2, and is refused with the local lake, so
#   a dev run can't write to production and a prod run can't quietly write to
#   a throwaway disk.
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_URL=
IS_PROD=false

# ============================================================================
# Docker: Linux user ID and group ID. Only needed on Linux; ignored on macOS.
# When running on Linux, docker-compose uses these to ensure files written
# to ./data/ are owned by your host user, not root.
# Get your IDs: `id -u` (UID) and `id -g` (GID).
# Set them before running: export UID=$(id -u) GID=$(id -g)
# Or add them to your shell profile (~/.zshrc, ~/.bashrc, etc.):
#   export UID=$(id -u)
#   export GID=$(id -g)
# On macOS, leave these as-is (they're the default values).
# ============================================================================
UID=1000
GID=1000

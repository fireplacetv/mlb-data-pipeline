# Local data directory. All pipeline output (lake, warehouse, logs, caches) lives here.
# Create this directory or any parent directories before running; the pipeline will create subdirs.
MLB_DATA_DIR=./data

# Lookback window in days. On catch-up, re-pull this many days before the last successful load
# to capture any revisions made by the data source. Keep this small; default is reasonable.
LOOKBACK_DAYS=4

# Maximum gap in days before catch-up refuses to run and asks for an explicit backfill command.
# Prevents silently skipping large date ranges if the pipeline hasn't run in a while.
MAX_CATCHUP_DAYS=30

# Giants team_id for reference (not yet used in filtering, but available for future features).
GIANTS_TEAM_ID=137

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# dbt schema naming mode. In dev mode, schemas are prefixed with dbt_<username>_
# to isolate each developer's work. In production, schemas use clean names.
# Leave as 'dev' for local development; set to 'production' for CI/prod.
DBT_OUTPUT_MODE=dev

# ============================================================================
# Lake destination (Phase 2). Leave these empty for the local lake under
# MLB_DATA_DIR, which is what development and CI use.
#
# BUCKET_URL: where dlt writes the raw Parquet lake.
#   empty                     -> <MLB_DATA_DIR>/lake (default)
#   file://<path>             -> another local folder (relative to the working
#                                directory; /app in the container). dbt still
#                                reads <MLB_DATA_DIR>/lake, so keep them the same.
#   https://<account id>.r2.cloudflarestorage.com/<bucket>[/<folder>]
#                             -> Cloudflare R2. Paste the bucket's "S3 API" URL
#                                (R2 -> your bucket -> Settings), optionally with
#                                a folder, e.g. .../mlb-lake/prod. Not the account
#                                endpoint alone: it must end in the bucket name.
#   s3://<bucket>/<path>      -> the same, with R2_ACCOUNT_ID below for the endpoint.
#   A remote lake needs IS_PROD=true and the two AWS_* keys below.
# IS_PROD: must be true to write to a remote lake, and is refused with a local
#   one, so a dev run can't write to production and a prod run can't quietly
#   write to a throwaway disk.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: an R2 API token's S3 credentials.
#   Secrets: set them only in your own .env (gitignored) or as GitHub Actions
#   Secrets, never in this file.
# R2_ACCOUNT_ID: only for an s3:// BUCKET_URL: your Cloudflare account ID; the
#   endpoint becomes https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com. Leave
#   empty with an https:// BUCKET_URL (the ID is already in it).
# ============================================================================
BUCKET_URL=
IS_PROD=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=

# ============================================================================
# Docker: Linux user ID and group ID. Only needed on Linux; ignored on macOS.
# When running on Linux, docker-compose uses these to ensure files written
# to ./data/ are owned by your host user, not root.
# Get your IDs: `id -u` (UID) and `id -g` (GID).
# Set them before running: export UID=$(id -u) GID=$(id -g)
# Or add them to your shell profile (~/.zshrc, ~/.bashrc, etc.):
#   export UID=$(id -u)
#   export GID=$(id -g)
# On macOS, leave these as-is (they're the default values).
# ============================================================================
UID=1000
GID=1000
